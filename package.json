{
  "name": "dsh-nba-board",
  "version": "1.3.1",
  "type": "module",
  "description": "NBA 每日看板：每天的比分、球员数据、东西部排名与热点新闻 TOP10（腾讯体育 + 直播吧，简体中文）。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "nba",
    "basketball",
    "scores",
    "news"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hujing0527/dsh-nba-board.git"
  },
  "homepage": "https://github.com/Hujing0527/dsh-nba-board#readme",
  "bugs": {
    "url": "https://github.com/Hujing0527/dsh-nba-board/issues"
  }
}
